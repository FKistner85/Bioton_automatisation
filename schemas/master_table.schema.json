{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bio-o-ton.local/schemas/master-table-row-v4.json",
  "schema_name": "bio_o_ton_master_table_row",
  "schema_version": "2026-08-04-mastertable-v4",
  "type": "object",
  "required": [
    "mastertable_schema_version",
    "workflow_run_id",
    "dawn_chorus_id",
    "metadata_status",
    "sound_status",
    "photo_status",
    "sentinel_status",
    "weather_point_status",
    "formation_100m_status",
    "formation_10m_status",
    "bioacoustic_status",
    "ready_for_bioacoustic_analysis",
    "ready_for_general_analysis",
    "ready_for_formation_analysis_100m",
    "ready_for_formation_analysis_10m",
    "record_status",
    "release_status"
  ],
  "properties": {
    "mastertable_schema_version": {"const": "2026-08-04-mastertable-v4"},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "dawn_chorus_id": {"type": "string", "pattern": "^[0-9]+$"},
    "source_fingerprint": {"type": ["string", "null"]},
    "datetime_local": {"type": ["string", "null"]},
    "datetime_utc": {"type": ["string", "null"]},
    "date_local": {"type": ["string", "null"]},
    "time_local": {"type": ["string", "null"]},
    "timestamp_source": {"type": ["string", "null"]},
    "timestamp_changed": {"type": "boolean"},
    "timestamp_change_reason": {"type": ["string", "null"]},
    "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "record_added_to_mastertable_utc": {"type": "string"},
    "record_updated_in_mastertable_utc": {"type": "string"},
    "metadata_status": {"$ref": "#/$defs/status"},
    "sound_exists": {"type": "boolean"},
    "sound_has_issues": {"type": "boolean"},
    "sound_issue_codes": {"type": "string"},
    "sound_status": {"$ref": "#/$defs/status"},
    "photo_exists": {"type": "boolean"},
    "photo_has_issues": {"type": "boolean"},
    "photo_issue_codes": {"type": "string"},
    "photo_status": {"$ref": "#/$defs/status"},
    "sentinel_exists": {"type": "boolean"},
    "sentinel_has_issues": {"type": "boolean"},
    "sentinel_quality_score": {"type": ["number", "null"]},
    "sentinel_issue_codes": {"type": "string"},
    "sentinel_status": {"$ref": "#/$defs/status"},
    "weather_point_exists": {"type": "boolean"},
    "weather_point_has_issues": {"type": "boolean"},
    "weather_point_issue_codes": {"type": "string"},
    "weather_point_status": {"$ref": "#/$defs/status"},
    "weather_raster_hostrada_100m_exists": {"type": "boolean"},
    "weather_raster_hostrada_100m_has_issues": {"type": "boolean"},
    "weather_raster_hostrada_100m_issue_codes": {"type": "string"},
    "grid_100m_id": {"type": ["string", "null"]},
    "grid_100m_assignment_exists": {"type": "boolean"},
    "grid_100m_has_majority_formation": {"type": "boolean"},
    "majority_formation_100m": {"type": ["string", "null"]},
    "majority_formation_status_100m": {"type": ["string", "null"], "enum": ["A", "B", "C", "K", "", null]},
    "majority_value_100m": {"$ref": "#/$defs/centiPercent"},
    "second_value_100m": {"$ref": "#/$defs/centiPercent"},
    "majority_delta_100m": {"$ref": "#/$defs/centiPercent"},
    "majority_disputed_100m": {"type": ["boolean", "null"]},
    "formation_100m_status": {"$ref": "#/$defs/status"},
    "grid_10m_id": {"type": ["string", "null"]},
    "grid_10m_assignment_exists": {"type": "boolean"},
    "grid_10m_has_majority_formation": {"type": "boolean"},
    "majority_formation_10m": {"type": ["string", "null"]},
    "majority_formation_status_10m": {"type": ["string", "null"], "enum": ["A", "B", "C", "K", "", null]},
    "majority_value_10m": {"$ref": "#/$defs/centiPercent"},
    "second_value_10m": {"$ref": "#/$defs/centiPercent"},
    "majority_delta_10m": {"$ref": "#/$defs/centiPercent"},
    "majority_disputed_10m": {"type": ["boolean", "null"]},
    "formation_10m_status": {"$ref": "#/$defs/status"},
    "formation_100m_10m_agree": {"type": "boolean"},
    "formation_status_100m_10m_agree": {"type": "boolean"},
    "formation_primary_variant": {"type": "string"},
    "formation_variant_count_expected": {"type": "integer", "minimum": 0},
    "formation_variants_with_100m_majority": {"type": "integer", "minimum": 0},
    "formation_variants_with_10m_majority": {"type": "integer", "minimum": 0},
    "formation_variant_products_complete": {"type": "boolean"},
    "bioacoustic_status": {"$ref": "#/$defs/status"},
    "bioacoustic_has_issues": {"type": "boolean"},
    "bioacoustic_issue_codes": {"type": "string"},
    "bioacoustic_models_expected": {"type": ["string", "null"]},
    "bioacoustic_models_complete": {"type": ["string", "null"]},
    "bioacoustic_required_models_complete": {"type": "boolean"},
    "bioacoustic_inference_version": {"type": ["string", "null"]},
    "bioacoustic_species_count": {"type": ["integer", "null"], "minimum": 0},
    "bird_species_count": {"type": ["integer", "null"], "minimum": 0},
    "nonbird_species_count": {"type": ["integer", "null"], "minimum": 0},
    "bioacoustic_max_confidence": {"type": ["number", "null"]},
    "top_species_scientific": {"type": ["string", "null"]},
    "top_species_model_support": {"type": ["integer", "null"], "minimum": 0},
    "ready_for_general_analysis": {"type": "boolean"},
    "ready_for_formation_analysis_100m": {"type": "boolean"},
    "ready_for_formation_analysis_10m": {"type": "boolean"},
    "ready_for_multimodal_analysis": {"type": "boolean"},
    "ready_for_bioacoustic_analysis": {"type": "boolean"},
    "record_blocking_issue_codes": {"type": "string"},
    "record_status": {"$ref": "#/$defs/status"},
    "release_status": {"$ref": "#/$defs/status"},
    "manual_review_comment": {"type": ["string", "null"]},
    "manual_reviewed_by": {"type": ["string", "null"]},
    "manual_reviewed_utc": {"type": ["string", "null"]}
  },
  "$defs": {
    "centiPercent": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000},
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "complete",
        "validated",
        "missing",
        "has_issues",
        "partial",
        "failed",
        "outdated",
        "not_applicable",
        "manual_review_required",
        "approved"
      ]
    }
  },
  "x-primary-key": "dawn_chorus_id",
  "x-validation-rules": [
    "dawn_chorus_id is unique",
    "majority_disputed_100m equals majority_delta_100m <= 200 when present",
    "majority_disputed_10m equals majority_delta_10m <= 200 when present"
  ]
}
